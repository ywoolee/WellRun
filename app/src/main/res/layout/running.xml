<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:orientation="vertical">

    <!-- 상단 헤더: 뒤로가기 버튼 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/running_btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_dark"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF"
            android:contentDescription="뒤로 가기" />
    </LinearLayout>

    <!-- 1. 통계 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="16dp">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2">

            <!-- 시간 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_stat_overlay"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="시간" android:textColor="#80FFFFFF" android:textSize="12sp" android:layout_marginBottom="4dp"/>
                <TextView android:id="@+id/tv_run_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00:00:00" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>
            </LinearLayout>

            <!-- 거리 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_stat_overlay"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="거리" android:textColor="#80FFFFFF" android:textSize="12sp" android:layout_marginBottom="4dp"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
                    <TextView android:id="@+id/tv_run_distance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" km" android:textColor="#80FFFFFF" android:textSize="14sp" android:layout_marginStart="2dp" android:layout_marginBottom="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 페이스 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_stat_overlay"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="페이스" android:textColor="#80FFFFFF" android:textSize="12sp" android:layout_marginBottom="4dp"/>
                <TextView android:id="@+id/tv_run_pace" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-' --&quot;" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>
            </LinearLayout>

            <!-- 평균 페이스 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_stat_overlay"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="심박수" android:textColor="#80FFFFFF" android:textSize="12sp" android:layout_marginBottom="4dp"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
                    <TextView android:id="@+id/tv_run_heart_rate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#FF3B30" android:textSize="20sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" BPM" android:textColor="#80FFFFFF" android:textSize="14sp" android:layout_marginStart="2dp" android:layout_marginBottom="2dp"/>
                </LinearLayout>
            </LinearLayout>

        </GridLayout>
    </LinearLayout>

    <!-- 2. 지도 영역 -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map_container"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 3. 하단 컨트롤 영역 (맨 아래 고정) -->
    <LinearLayout
        android:id="@+id/bottom_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#111111"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="64dp">

        <!-- ✨ 초기 상태: 재생(시작) 버튼만 표시 -->
        <ImageButton
            android:id="@+id/btn_start_run"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_circle_gradient"
            android:src="@android:drawable/ic_media_play"
            app:tint="#FFFFFF"
            android:scaleType="centerInside"
            android:padding="20dp"
            />

        <!-- ✨ 러닝 중 상태: 일시정지, 정지 버튼 그룹 (초기에는 gone) -->
        <LinearLayout
            android:id="@+id/layout_running_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btn_pause_run"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_circle_outline"
                android:src="@android:drawable/ic_media_pause"
                app:tint="#FF6B35"
                android:scaleType="centerInside"
                android:padding="16dp" />

            <View
                android:layout_width="32dp"
                android:layout_height="match_parent" />

            <ImageButton
                android:id="@+id/btn_stop_run"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_circle_gradient"
                android:src="@android:drawable/ic_media_ff"
                app:tint="#FFFFFF"
                android:scaleType="centerInside"
                android:padding="20dp" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>