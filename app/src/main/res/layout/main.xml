<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_fixed_area"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#111111"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="48dp"
                android:paddingBottom="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2026년 5월"
                            android:textColor="#555555"
                            android:textSize="12sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="주간 달리기 요약"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:orientation="horizontal">
                        <TextView android:layout_width="32dp" android:layout_height="32dp" android:text="&lt;" android:textColor="#888888" android:gravity="center" android:background="@drawable/bg_card_dark"/>
                        <View android:layout_width="8dp" android:layout_height="match_parent"/>
                        <TextView android:layout_width="32dp" android:layout_height="32dp" android:text="&gt;" android:textColor="#888888" android:gravity="center" android:background="@drawable/bg_card_dark"/>
                    </LinearLayout>
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="7">

                    <LinearLayout
                        android:id="@+id/btn_day_23"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:layout_marginHorizontal="2dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="일" android:textColor="#555555" android:textSize="11sp" android:layout_marginBottom="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="23" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>
                        <View android:layout_width="6dp" android:layout_height="6dp" android:background="@drawable/bg_dot_orange" android:layout_marginTop="6dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_day_24"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_card_dark"
                        android:paddingVertical="8dp"
                        android:layout_marginHorizontal="2dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="월" android:textColor="#FF6B35" android:textSize="11sp" android:layout_marginBottom="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="24" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>
                        <View android:layout_width="6dp" android:layout_height="6dp" android:background="@drawable/bg_dot_orange" android:layout_marginTop="6dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_day_25"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:layout_marginHorizontal="2dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="화" android:textColor="#555555" android:textSize="11sp" android:layout_marginBottom="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="25" android:textColor="#888888" android:textSize="15sp"/>
                        <View android:layout_width="6dp" android:layout_height="6dp" android:visibility="invisible" android:layout_marginTop="6dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E1E1E"/>

            <LinearLayout
                android:id="@+id/layout_past_record_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_selected_date_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🗓️ 선택한 날짜에 내가 달린 기록"
                    android:textColor="#888888"
                    android:textSize="13sp"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="horizontal"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="달린 거리" android:textColor="#666666" android:textSize="12sp"/>
                        <TextView android:id="@+id/tv_past_distance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00 km" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="당시 페이스" android:textColor="#666666" android:textSize="12sp"/>
                        <TextView android:id="@+id/tv_past_pace" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-'-&quot;" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="러닝 시간" android:textColor="#666666" android:textSize="12sp"/>
                        <TextView android:id="@+id/tv_past_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00:00" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tv_main_weather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☀️ 서울 19°C 맑음"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp"
                    android:textStyle="normal" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" | 야외 러닝하기 쾌적한 상태입니다."
                    android:textColor="#666666"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🤖 AI 러닝 코치 가이드"
                    android:textColor="#FF6B35"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_toggle_selected"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tv_ai_comment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="오늘 아침 체크하신 무릎 피로도를 고려해 심박수가 과도하게 오르지 않는 완만한 페이스 조절을 권장합니다. 무리하지 않는 선에서 가볍게 달려보세요."
                        android:textColor="#DDDDDD"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="16dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#2E2E2E"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="추천 거리" android:textColor="#888888" android:textSize="13sp" />
                            <TextView android:id="@+id/tv_recommended_distance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4.5 km" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#2E2E2E" android:layout_marginHorizontal="8dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="추천 페이스" android:textColor="#888888" android:textSize="13sp" />
                            <TextView android:id="@+id/tv_recommended_pace" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6' 30&quot;" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottom_fixed_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="48dp"
        android:orientation="vertical"
        android:background="#0D0D0D">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/main_daily_check"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_orange_gradient"
                android:text="오늘의 컨디션"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E1E1E"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:weightSum="4"
            android:gravity="center_vertical">

            <!-- 1. 캘린더 탭 (현재 활성화된 상태) -->
            <TextView
                android:id="@+id/nav_calendar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="캘린더"
                android:textColor="#FF6B35"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <!-- 2. 러닝 탭 -->
            <TextView
                android:id="@+id/main_nav_running"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="러닝"
                android:textColor="#888888"
                android:gravity="center"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <!-- 3. 코스 탭 -->
            <TextView
                android:id="@+id/main_nav_course"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="코스"
                android:textColor="#888888"
                android:gravity="center"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <!-- 4. 마이페이지 탭 -->
            <TextView
                android:id="@+id/main_nav_mypage"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="마이페이지"
                android:textColor="#888888"
                android:gravity="center"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>