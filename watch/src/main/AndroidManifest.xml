<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.wellrun">

    <!-- ✨ 1. WHS 심박수 측정을 위한 필수 신체 센서 권한 -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- 2. 기본 포그라운드 및 알림 권한 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ✨ 3. 안드로이드 14(API 34) 이상 워치에서 센서를 사용하기 위한 health 타입 권한 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />

    <!-- 워치 전용 앱 명시 -->
    <uses-feature android:name="android.hardware.type.watch" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <uses-library
            android:name="com.google.android.wearable"
            android:required="true" />

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".WearCommandReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:host="*" android:pathPrefix="/pause_run" android:scheme="wear" />
                <data android:host="*" android:pathPrefix="/resume_run" android:scheme="wear" />
                <data android:host="*" android:pathPrefix="/update_pace" android:scheme="wear" />
                <data android:host="*" android:pathPrefix="/start_hr" android:scheme="wear" />
                <data android:host="*" android:pathPrefix="/stop_hr" android:scheme="wear" />
                <data android:host="*" android:pathPrefix="/update_distance" android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- ✨ 4. 포그라운드 서비스 타입을 health로 변경 -->
        <service
            android:name=".HeartRateService"
            android:foregroundServiceType="health"
            android:exported="false"
            tools:node="replace" />

    </application>
</manifest>